    "qualification": "Streaming AVC/HEVC native packet and presentation identity, including independently drained source EOF; exact 48-kHz 5.1 AAC/AC-3 context proof. Existing AV1 Main 8-bit and independent-program stereo/5.1 E-AC-3 remain separate policies. Streaming limits: 64 GiB output, six hours, ten million packets, 300 seconds wall time, 16 MiB individual packets, 2073600 pixels, two decoder threads."
  },

  "accurateCut": {
    "worker": "scene/vidsc_accurate_job.py",
    "helpers": ["scene/vidsc_accurate_codec.py", "scene/vidsc_accurate_audio.py"],
    "runtime": "scene.relocatableRuntime; isolated in-process PyAV encoders; separate CLI terminal reader",
    "qualityPolicy": "accurate-cfr-reference-crf18-slow-v1",
    "limits": "512 source pictures, 64 MiB compressed window, 64 boundary pixel views / 256 MiB, one output view, 1 GiB private process bytes, two codec threads",
    "qualification": "MP4 AVC/x264 or HEVC Main10/x265 CFR only; fail closed for unqualified topology, display/HDR/HRD, MOV and NVIDIA"
  },

