<Window x:Class="Vidsc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vidsc.App.Controls"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        Title="vidsc"
        Height="820"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Background="#101418"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI"
        FontSize="12"
        PreviewKeyDown="OnNavigationKeyDown"
        Closing="OnWindowClosing">

  <DockPanel>

    <!-- Transport controls live outside the Flyleaf video surface on purpose. -->
    <Border DockPanel.Dock="Top" Background="#161C22" Padding="8,6">
      <WrapPanel>
        <Button Content="Open..." Width="88" Margin="0,0,6,0" Click="OnOpenClick" />
        <Button Content="Project…" Command="{Binding OpenProjectCommand}" Margin="0,0,4,0" />
        <Button Content="Save" Command="{Binding SaveProjectCommand}" Margin="0,0,4,0" />
        <Button Content="Recover" Command="{Binding RecoverProjectCommand}" Margin="0,0,8,0" />
        <Button Content="Play / Pause" Width="104" Margin="0,0,6,0" Command="{Binding PlayPauseCommand}" />
        <Button Content="&lt; Frame" Width="78" Margin="0,0,6,0" Command="{Binding StepBackwardCommand}" />
        <Button Content="Frame &gt;" Width="78" Margin="0,0,14,0" Command="{Binding StepForwardCommand}" />

        <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center"
                Value="{Binding Volume, Mode=TwoWay}" />
        <Button Content="Mute" Width="60" Margin="6,0,14,0" Command="{Binding ToggleMuteCommand}" />

        <TextBlock Text="Rotation" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="RotationBox" Width="90" SelectedIndex="0" SelectionChanged="OnRotationChanged">
          <ComboBoxItem Content="0 deg" />
          <ComboBoxItem Content="90 deg" />
          <ComboBoxItem Content="180 deg" />
          <ComboBoxItem Content="270 deg" />
        </ComboBox>

        <Button Content="Packaged CLI check" Width="150" Margin="14,0,6,0" Command="{Binding ToolCheckCommand}" />
        <Button Content="Scene check" Width="110" Command="{Binding SceneCheckCommand}" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#161C22" Padding="8,6">
      <StackPanel>
        <DockPanel>
          <ComboBox Width="145" Margin="0,0,8,0" ItemsSource="{Binding TimeModes}" SelectedItem="{Binding TimeMode}" />
          <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Right" Content="Seek target" Width="86" Margin="8,0,0,0"
                  Command="{Binding CommitDesiredCommand}" />
          <TextBox Width="170" HorizontalAlignment="Left"
                   Text="{Binding DesiredTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnDesiredTimeKeyDown"
                   ToolTip="Use the selected format: milliseconds, nominal HH:MM:SS:FF, or zero-based file frame index. Enter seeks the target; displayed frame remains advisory." />
        </DockPanel>

        <WrapPanel Margin="0,6,0,4">
          <Button Content="−" Width="32" Click="OnZoomOut" />
          <Button Content="+" Width="32" Click="OnZoomIn" />
          <Button Content="Fit" Width="48" Click="OnTimelineFit" />
          <Button Content="Center playhead" Width="110" Click="OnTimelineCenter" />
          <TextBlock Text="{Binding TimelineScaleText}" VerticalAlignment="Center" Margin="8,0" />
          <Button Content="Inspect neighborhood" Margin="12,0,4,0" Command="{Binding InspectNeighborhoodCommand}" />
          <Button Content="Verify inspected access point" Margin="0,0,4,0" Command="{Binding VerifyAccessPointCommand}" ToolTip="Compare a fresh decoder with the full reference for the last inspected candidate. Bounded AVC/HEVC sources up to 16 MiB; no splice or EOF certification." />
          <Button Content="Build keyframes" Margin="0,0,4,0" Command="{Binding BuildKeyframesCommand}" />
          <Button Content="Build frame index" Command="{Binding BuildFrameIndexCommand}" />
          <Button Content="Cancel index" Margin="4,0" Command="{Binding CancelIndexCommand}" />
          <Button Content="Load visible thumbnails" Command="{Binding LoadThumbnailsCommand}" />
        </WrapPanel>
        <local:TimelineControl x:Name="Timeline" AutomationProperties.AutomationId="NavigationTimeline" AutomationProperties.Name="Video navigation timeline" PreviewMouseWheel="OnNavigationWheel" Duration="{Binding SliderMaximumTicks}" Position="{Binding DesiredSliderTicks}" Markers="{Binding KeyframeTicks}" InPosition="{Binding EditorInTicks}" OutPosition="{Binding EditorOutTicks}" />
        <ScrollBar x:Name="TimelineScroll" Orientation="Horizontal" Minimum="0" SmallChange="10000000" Scroll="OnTimelineScroll" />
        <ItemsControl ItemsSource="{Binding VisibleThumbnails}" Height="54">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Image}" Stretch="Uniform" ToolTip="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Space: play/pause • ←/→: frame • PgUp/PgDn: ±10 s • I/O: confirmed In/Out • ↑/↓: access • [/]: scenes • Ctrl+Z/Y: undo/redo" Foreground="#9FB3C8" />
        <TextBlock Text="Drag I/O handles: requested numeric boundary • Shift-drag: pan • bottom overview: move viewport • thumbnails: advisory only" Foreground="#9FB3C8" />
        <TextBlock Text="Navigation shortcuts work on the video surface and timeline. Text entry, rotation and volume keep their own controls." Foreground="#9FB3C8" />
        <TextBlock Text="{Binding NavigationReason}" TextWrapping="Wrap" Foreground="#F0B429" />
          <TextBlock Text="{Binding InspectionSummary}" TextWrapping="Wrap" Foreground="#9FB3C8" />
          <TextBlock Text="{Binding InspectionCapabilities}" TextWrapping="Wrap" Foreground="#9FB3C8" />
        <TextBlock Text="{Binding TimeModeHint}" TextWrapping="Wrap" Foreground="#9FB3C8" />

        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="desired" Foreground="#9FB3C8" />
          <TextBlock Grid.Column="1" Text="{Binding DesiredTimeText}" />
          <TextBlock Grid.Column="2" Text="requested" Foreground="#9FB3C8" />
          <TextBlock Grid.Column="3" Text="{Binding RequestedText}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="pending" Foreground="#9FB3C8" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PendingText}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="seed state" Foreground="#9FB3C8" />
          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SeekStateText}" />
        </Grid>
      </StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#0C1014">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusLine}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding ExactEditingText, StringFormat=exact In/Out: {0}}" Foreground="#F0B429" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="430" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" PreviewMouseWheel="OnNavigationWheel" Background="#05070A" BorderBrush="#222C36" BorderThickness="1">
        <fl:FlyleafHost x:Name="Host" OpenOnDrop="None" SwapOnDrop="None" />
      </Border>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#222C36" />

      <TabControl Grid.Column="2" Background="#141A20" BorderBrush="#222C36">
        <TabItem Header="Segments" IsSelected="True">
          <ScrollViewer Padding="8"><StackPanel>
            <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" />
            <Button Content="New project for current source" Command="{Binding NewProjectCommand}" Margin="0,6" />
            <TextBlock Text="Segment name" />
            <TextBox Text="{Binding SegmentName, UpdateSourceTrigger=PropertyChanged}" />
            <WrapPanel Margin="0,6">
              <Button Content="In (I)" Command="{Binding ConfirmInCommand}" Margin="0,0,6,0" />
              <Button Content="Out (O)" Command="{Binding ConfirmOutCommand}" />
            </WrapPanel>
            <TextBlock Text="Requested In / Out (UI seconds)" />
            <StackPanel Orientation="Horizontal"><TextBox Width="125" Text="{Binding CopyStartSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" /><TextBox Width="125" Text="{Binding CopyEndSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <WrapPanel Margin="0,6">
              <Button Content="Add" Command="{Binding AddSegmentCommand}" />
              <Button Content="Apply" Command="{Binding ApplySegmentCommand}" Margin="4,0" />
              <Button Content="Remove" Command="{Binding RemoveSegmentCommand}" />
              <Button Content="↑" Command="{Binding MoveSegmentUpCommand}" Margin="4,0" />
              <Button Content="↓" Command="{Binding MoveSegmentDownCommand}" />
              <Button Content="Undo" Command="{Binding UndoEditorCommand}" Margin="4,0" />
              <Button Content="Redo" Command="{Binding RedoEditorCommand}" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" DisplayMemberPath="Name" Height="150" />
            <Button Content="Qualify copy plan" Command="{Binding PreviewCopyCommand}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding EditorSummary}" TextWrapping="Wrap" Margin="0,8" />
            <TextBlock Text="{Binding CopyExportSummary}" TextWrapping="Wrap" />
            <TextBlock Text="Choose tracks, container and destination in Stream copy. Each queued job freezes current interval and choices." TextWrapping="Wrap" Foreground="#9FB3C8" Margin="0,8" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Position">
          <ScrollViewer Padding="8">
            <StackPanel>
              <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="#CFE0F0" />
              <Separator Margin="0,8" />

              <TextBlock Text="Observed presentation (proven hook only)" Foreground="#9FB3C8" />
              <TextBlock Text="{Binding ObservedText}" TextWrapping="Wrap" Margin="0,0,0,6" />

              <TextBlock Text="Engine-reported seek completion" Foreground="#9FB3C8" />
              <TextBlock Text="{Binding CompletionText}" TextWrapping="Wrap" Margin="0,0,0,6" />

              <TextBlock Text="Engine advisory time (Player.CurTime)" Foreground="#9FB3C8" />
              <TextBlock Text="{Binding AdvisoryText}" TextWrapping="Wrap" Margin="0,0,0,6" />

              <TextBlock Text="Scrub statistics" Foreground="#9FB3C8" />
              <TextBlock Margin="0,0,0,6">
                <Run Text="approximate seeks issued: " /><Run Text="{Binding ApproximateSeekCount, Mode=OneWay}" />
                <LineBreak />
                <Run Text="coalesced away while dragging: " /><Run Text="{Binding CoalescedSeekCount, Mode=OneWay}" />
              </TextBlock>

              <Separator Margin="0,8" />
              <TextBlock Text="Exact editing" Foreground="#9FB3C8" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Set In (exact)" Width="110" Command="{Binding ConfirmInCommand}"
                        ToolTip="{Binding ExactEditingReason}" Margin="0,0,6,0" />
                <Button Content="Set Out (exact)" Width="110" Command="{Binding ConfirmOutCommand}"
                        ToolTip="{Binding ExactEditingReason}" Margin="0,0,6,0" />
                <Button Content="Copy plan" Width="90" Command="{Binding PreviewCopyCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding ExactEditingReason}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#F0B429" />

              <Separator Margin="0,8" />
              <TextBlock Text="ffprobe facts (packaged CLI)" Foreground="#9FB3C8" />
              <TextBlock Text="{Binding SourceFactsText}" TextWrapping="Wrap" FontFamily="Consolas" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Stream copy">
          <ScrollViewer Padding="8">
            <StackPanel>
              <TextBlock Text="Numeric times resolve forward to observed source frames. The selected copy policy may expand or contract that interval." TextWrapping="Wrap" />
              <TextBlock Text="In / Out (seconds, decimal point)" Margin="0,8,0,2" />
              <StackPanel Orientation="Horizontal">
                <TextBox Width="110" Text="{Binding CopyStartSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <TextBox Width="110" Text="{Binding CopyEndSeconds, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <TextBlock Text="Boundary policy / destination container" Margin="0,8,0,2" />
              <ComboBox ItemsSource="{Binding CopyPolicies}" SelectedItem="{Binding SelectedCopyPolicy}" />
              <ComboBox ItemsSource="{Binding CopyContainers}" SelectedItem="{Binding SelectedCopyContainer}" Margin="0,4,0,0" />
              <TextBlock Text="Primary video is retained. Select additional tracks explicitly:" TextWrapping="Wrap" Margin="0,8,0,2" />
              <ItemsControl ItemsSource="{Binding CopyTracks}">
                <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Content="Preserve intersecting chapters (Matroska)" IsChecked="{Binding PreserveCopyChapters}" Margin="0,6,0,0" />
              <TextBlock Text="Metadata: Matroska preserves title/language and track flags. MP4 keeps audio language (und if absent), selects the first audio as default if none selected is default, and omits chapters/other metadata. No subtitle conversion." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#9FB3C8" />
              <TextBlock Text="Destination (empty opens file chooser; existing files are preserved)" TextWrapping="Wrap" Margin="0,8,0,2" />
              <TextBox Text="{Binding CopyDestination, UpdateSourceTrigger=PropertyChanged}" />
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Queue stream copy" Command="{Binding StartCopyExportCommand}" Margin="0,0,6,4" />
                <Button Content="Qualify plan" Command="{Binding PreviewCopyCommand}" Margin="0,0,6,4" />
                <Button Content="Open validated output" Command="{Binding OpenCopyOutputCommand}" Margin="0,0,6,4" />
                <Button Content="Cancel export" Command="{Binding CancelCopyExportCommand}" Margin="0,0,6,4" />
                <Button Content="Reconcile failed worker" Command="{Binding ReconcileCopyWorkerCommand}" Margin="0,0,6,4" />
              </WrapPanel>
              <TextBlock Text="{Binding CopyExportSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock Text="MP4: qualified AAC/AC-3 copied packets, not sample-exact; no subtitles/chapters. Matroska: video/SubRip and chapters; audio timing remains unqualified. Existing destinations are preserved." TextWrapping="Wrap" Foreground="#F0B429" Margin="0,6" />
              <ItemsControl ItemsSource="{Binding ExportQueue}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Destination}" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Diagnostics">
          <ScrollViewer Padding="8">
            <StackPanel>
              <TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" TextWrapping="Wrap" />
              <Separator Margin="0,8" />
              <TextBlock Text="{Binding ToolsetText}" FontFamily="Consolas" TextWrapping="Wrap" />
              <Separator Margin="0,8" />
              <TextBlock Text="{Binding ManifestText}" FontFamily="Consolas" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Log">
          <ScrollViewer Padding="8">
            <ItemsControl ItemsSource="{Binding LogLines}" FontFamily="Consolas" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

  </DockPanel>
</Window>
